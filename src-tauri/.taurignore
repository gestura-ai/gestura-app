# Tauri ignore file - prevents rebuild loops
# Files and directories that should not trigger rebuilds

# Build artifacts
target/
dist/
build/
out/

# Dependencies
node_modules/
.pnpm-store/
.yarn/

# Icons and assets (these shouldn't trigger rebuilds)
icons/
assets/
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.icns

# Documentation
docs/
*.md
README*
CHANGELOG*
LICENSE*

# Scripts
scripts/
*.sh
*.bat
*.ps1

# Logs and temporary files
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Version control
.git/
.gitignore
.gitattributes

# Package files
package-lock.json
yarn.lock
pnpm-lock.yaml
Cargo.lock

# Environment files
.env*

# Test files
tests/
test/
*.test.*
*.spec.*

# Coverage reports
coverage/
.nyc_output/

# Backup files
*.bak
*.backup

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
