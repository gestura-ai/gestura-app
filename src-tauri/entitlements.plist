<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Network access for AI providers and MCP servers -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- Network server for local MCP and device communication -->
    <key>com.apple.security.network.server</key>
    <true/>
    
    <!-- File system access for configuration, logs, and user data -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <!-- Bluetooth access for Haptic Harmony Ring connectivity -->
    <key>com.apple.security.device.bluetooth</key>
    <true/>

    <!-- USB access for potential future hardware connections -->
    <key>com.apple.security.device.usb</key>
    <true/>

    <!-- Camera access disabled by default (future AR features) -->
    <key>com.apple.security.device.camera</key>
    <false/>

    <!-- Microphone access disabled by default (can be enabled later) -->
    <key>com.apple.security.device.audio-input</key>
    <false/>

    <!-- Disable App Sandbox for development tool -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Allow JIT compilation for performance -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory for Rust/WASM -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Disable library validation for development -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Hardened runtime compatibility -->
    <key>com.apple.security.cs.debugger</key>
    <false/>
</dict>
</plist>
