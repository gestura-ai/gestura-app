<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Network access for AI providers and MCP servers -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Network server for local MCP server mode -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Disable App Sandbox (CLI tool needs full filesystem access) -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Allow JIT compilation for performance -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory for Rust/WASM -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Disable library validation for development -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>

