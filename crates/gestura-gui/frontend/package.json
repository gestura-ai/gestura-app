{
  "name": "gestura-frontend",
  "version": "0.5.0",
  "description": "Gestura desktop app frontend (React + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "cd .. && cargo tauri",
    "tauri:dev": "cd .. && cargo tauri dev --features voice-local",
    "tauri:build": "npm run build && cd .. && cargo tauri build --features voice-local",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "node ./scripts/playwright.mjs test --config ../../../tests/e2e/playwright.config.ts",
    "test:e2e:smoke": "node ./scripts/playwright.mjs test --config ../../../tests/e2e/playwright.config.ts --project=chromium --grep @smoke --workers=1 --reporter=line",
    "test:e2e:ui": "node ./scripts/playwright.mjs test --config ../../../tests/e2e/playwright.config.ts --ui",
    "test:e2e:install": "playwright install",
    "lint": "eslint ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.1",
    "@codemirror/merge": "^6.12.0",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.14",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.40.0",
    "@tauri-apps/cli": "^2.9.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.0-canary-da641178-20260129",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.54.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
