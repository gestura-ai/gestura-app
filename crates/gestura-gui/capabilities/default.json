{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "main-capability",
  "description": "Main capability for the Gestura desktop application",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-center",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-decorations",
    "core:window:allow-set-resizable",
    "core:window:allow-set-minimizable",
    "core:window:allow-set-maximizable",
    "core:window:allow-set-closable",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-visible",
    "core:window:allow-is-focused",
    "core:window:allow-is-maximized",
    "core:window:allow-is-minimized",
    "core:window:allow-is-decorated",
    "core:window:allow-is-resizable",
    "core:window:allow-is-closable",
    "core:window:allow-is-maximizable",
    "core:window:allow-is-minimizable",
    "core:window:allow-inner-size",
    "core:window:allow-outer-size",
    "core:window:allow-inner-position",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-current-monitor",
    "core:window:allow-primary-monitor",
    "core:window:allow-available-monitors",
    "core:app:default",
    "core:app:allow-version",
    "core:app:allow-name",
    "core:app:allow-tauri-version",
    "core:path:default",
    "core:tray:default",
    "global-shortcut:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "dialog:default",
    "dialog:allow-open"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*",
      "https://huggingface.co/*",
      "https://*.huggingface.co/*",
      "https://api.openai.com/*",
      "https://api.anthropic.com/*"
    ]
  }
}