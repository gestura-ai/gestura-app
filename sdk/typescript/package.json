{
  "name": "@gestura/ring-sdk",
  "version": "0.3.1",
  "description": "TypeScript SDK for the Gestura Haptica Harmony B1 ring and its simulator. Wraps the Rust Shared Semantic Protocol (compiled to WebAssembly) with an ergonomic, W3C-style event API. Transport-agnostic: ships a Tauri adapter today, Web Bluetooth next.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tauri": {
      "types": "./dist/transport/tauri.d.ts",
      "import": "./dist/transport/tauri.js"
    },
    "./wasm": {
      "types": "./wasm/gestura_protocol.d.ts",
      "import": "./wasm/gestura_protocol.js"
    },
    "./wasm/inline": {
      "types": "./wasm/gestura_protocol_inline.d.ts",
      "import": "./wasm/gestura_protocol_inline.js"
    }
  },
  "files": [
    "dist",
    "wasm",
    "src",
    "!src/**/*.test.ts",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build:wasm": "cd ../../crates/gestura-protocol && wasm-pack build --release --target web --out-dir ../../sdk/typescript/wasm -- --features wasm && cd ../../sdk/typescript && node scripts/inline-wasm.mjs",
    "build": "npm run build:wasm && tsc -p tsconfig.build.json",
    "pretypecheck": "node scripts/ensure-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/ensure-wasm.mjs",
    "test": "vitest run"
  },
  "keywords": [
    "gestura",
    "haptic",
    "ring",
    "ble",
    "gesture",
    "wearable",
    "wasm"
  ],
  "license": "LicenseRef-Gestura-Prosperity-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/gestura-ai/gestura-app.git",
    "directory": "sdk/typescript"
  },
  "peerDependencies": {
    "@tauri-apps/api": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
